#!/bin/bash
#PBS -N merge_mtdna_snps
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=2:mem=8gb

# =============================================================================
# Merge all per-sample mtDNA VCFs (from 35_call_mtdna_snps.pbs) into one
# joint multi-sample mtDNA SNP callset for the eQTL analysis.
#
# Submit with:  qsub merge_mtdna_snps.pbs
# =============================================================================

set -euo pipefail

module add app/bcftools/1.19

cd "$PBS_O_WORKDIR"

mkdir -p logs
exec > logs/merge_mtdna_snps.run.log 2>&1

echo "Started at $(date)"

# ---- EDIT THESE PATHS ----
MANIFEST="fastq_manifest.txt"
SNP_CALLS_DIR="mtdna_snp_calls"
OUT_VCF="mtdna_joint_genotyped.vcf.gz"
# ---------------------------

VCF_LIST="mtdna_vcf_list.txt"
> "$VCF_LIST"
MISSING=0

while read -r LINE; do
    SAMPLE=$(echo "$LINE" | cut -f1)
    VCF="$SNP_CALLS_DIR/$SAMPLE/${SAMPLE}.mtdna.vcf.gz"
    if [[ -f "$VCF" ]]; then
        echo "$VCF" >> "$VCF_LIST"
    else
        echo "WARNING: missing $VCF" >&2
        MISSING=$((MISSING+1))
    fi
done < "$MANIFEST"

N_SAMPLES=$(wc -l < "$VCF_LIST")
echo "Found $N_SAMPLES per-sample mtDNA VCFs ($MISSING missing)"

bcftools merge -l "$VCF_LIST" -Oz -o "$OUT_VCF"
tabix -p vcf "$OUT_VCF"

echo "Done at $(date)"
echo "Joint mtDNA VCF: $OUT_VCF"
zcat "$OUT_VCF" | grep -v "^##" | head -1 | tr '\t' '\n' | wc -l
zcat "$OUT_VCF" | grep -vc "^#"

